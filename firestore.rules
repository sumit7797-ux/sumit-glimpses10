rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() {
      return request.auth != null && request.auth.token.email == "admin@sumitglimpses.com";
    }
    match /orders/{c} {
      allow get: if true;
      allow list, write: if admin();
    }
    match /samples/{c} {
      allow read: if true;
      allow write: if admin();
    }
    match /claims/{c} {
      allow create, update: if true;
      allow read, delete: if admin();
    }
    match /feedback/{c} {
      allow create, update: if true;
      allow read, delete: if admin();
    }
  }
}
